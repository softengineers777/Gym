@model IEnumerable<GuayabitosMvc.Models.Clientes>
@{
    ViewData["Title"] = "Clientes";
}
<link rel="stylesheet" href="https://unpkg.com/bootstrap-table@1.22.6/dist/bootstrap-table.min.css">
<br>
<div class="col-md-12">
   <a href="/Clientes/Create" class="btn btn-success" onclick="window.location.href='/Clientes/Create'; return false;">
    <i class="fa fa-plus me-2"></i> Nuevo Cliente
</a>
</div>

<div class="content-wrapper">
    <div class="container p-5 my-5 border">
        <div class="table-responsive">
            <table id="pagination" class="ui celled table table-striped table-hover" data-toggle="table"
                   data-pagination="true" data-search="true" data-page-size="10" data-page-list="[5, 10, 25, 50, all]"
                   data-locale="es-ES" table table-sm>
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.IdCliente)
                        </th>
                        <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.Telefono)
                        </th>
                        <th>@Html.DisplayNameFor(model => model.email)</th@Html.DisplayNameFor>
                            <th>@Html.DisplayNameFor(model =>
                                                                                                                                                                                                                                                            model.fecha_registro)</th@Html.DisplayNameFor>
                                <th>Acccion</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.IdCliente)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                                    <td>@Html.DisplayFor(modelItem => item.email)</td>
                                    <td>@Html.DisplayFor(modelItem => item.fecha_registro)</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.IdCliente" class="btn btn-sm btn-warning">
                                            <i class="fa-regular fa-pen-to-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.IdCliente" class="btn btn-sm btn-info">
                                            <i class="fa-solid fa-info"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdCliente" class="btn btn-sm btn-danger">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @section Scripts {
            <!-- Bootstrap Table JS -->
            <script src="https://unpkg.com/bootstrap-table@1.22.6/dist/bootstrap-table.min.js"></script>
            <script src="https://unpkg.com/bootstrap-table@1.22.6/dist/locale/bootstrap-table-es-ES.min.js"></script>
        }