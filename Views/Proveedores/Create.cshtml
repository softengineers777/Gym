@model List<GuayabitosMvc.Models.Proveedores>

@{
    @* ViewData["Title"] = "Crear Proveedores"; *@
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Provedores</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/targetaMultiple.css">
        <script src="~/js/Multiple.js"></script>
  
    </head>

    <body>
        <div class="container mt-4">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-users"></i> Registrar Múltiples Proveedores
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateMultiple" method="post" id="multipleForm">
                        @Html.AntiForgeryToken()
                        <div id="proveedores-container">
                        </div>
                    
                        <div class="mt-3">
                            <button type="button" class="btn btn-primary" onclick="agregarProveedor()">
                                <i class="fas fa-plus"></i> Agregar Proveedor
                            </button>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Guardar Todos
                            </button>
                            <a href="/Clientes/Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </body>

</html>