@model IEnumerable<GuayabitosMvc.Models.Empleados>
@{
    ViewData["Title"] = "Empleados";
}
<link rel="stylesheet" href="https://unpkg.com/bootstrap-table@1.22.6/dist/bootstrap-table.min.css">
<br>
<div class="col-md-12">
   <a href="/Empleados/Create" class="btn btn-success" onclick="window.location.href='/Empleados/Create'; return false;">
    <i class="fa fa-plus me-2"></i> Nuevo Empleado
</a>
</div>

<div class="content-wrapper">
    <div class="container p-5 my-5 border">
        <div class="table-responsive">
            <table id="pagination" class="ui celled table table-striped table-hover" data-toggle="table"
                   data-pagination="true" data-search="true" data-page-size="10" data-page-list="[5, 10, 25, 50, all]"
                   data-locale="es-ES">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.IdEmpleado)
                        </th>
                        <th>@Html.DisplayNameFor(model => model.Codigo)</th>
                        <th>@Html.DisplayNameFor(model => model.nombre)
                        </th>
                        <th>@Html.DisplayNameFor(model => model.IdRol)</th>
                        <th>@Html.DisplayNameFor(model => model.puesto)</th>
                        <th>@Html.DisplayNameFor(model => model.Usuario_Login)</th>
                        <th>@Html.DisplayNameFor(model => model.Contraseña_hash)</th>
                        <th>@Html.DisplayNameFor(model => model.telefono)</th>
                        <th>@Html.DisplayNameFor(model => model.email)</th>
                        <th>@Html.DisplayNameFor(model => model.fecha_contratacion)</th>
                        <th>@Html.DisplayNameFor(model => model.salario)</th>
                        
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.IdEmpleado)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Codigo)</td>
                                    <td>@Html.DisplayFor(modelItem => item.nombre)</td>
                                    <td>@Html.DisplayFor(modelItem => item.IdRol)</td>
                                    <td>@Html.DisplayFor(modelItem => item.puesto)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Usuario_Login)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Contraseña_hash)</td>
                                    <td>@Html.DisplayFor(modelItem => item.telefono)</td>
                                    <td>@Html.DisplayFor(modelItem => item.fecha_contratacion)</td>
                                    <td>@Html.DisplayFor(modelItem => item.salario)</td>

                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-warning">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-info">
                                            <i class="fa fa-info-circle"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-danger">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @section Scripts {
            <!-- Bootstrap Table JS -->
            <script src="https://unpkg.com/bootstrap-table@1.22.6/dist/bootstrap-table.min.js"></script>
            <script src="https://unpkg.com/bootstrap-table@1.22.6/dist/locale/bootstrap-table-es-ES.min.js"></script>
        }